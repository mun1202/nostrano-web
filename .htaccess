# Generato da web/genera/costruisci.mjs: non modificarlo qui.
ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes
RedirectMatch 404 /\.git
RedirectMatch 404 /\.ht

# Sito nascosto finché non è pronto (protezione in web/genera/impostazioni.mjs): serve nome e password.
AuthType Basic
AuthName "Il mio contadino - in preparazione"
AuthUserFile "/home/u613982683/domains/ilmiocontadino.com/.htpasswd"
Require valid-user

AddType text/javascript .js .mjs
AddType application/manifest+json .webmanifest
AddType application/x-protobuf .pbf

RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ilmiocontadino.com%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Pagine sempre fresche; script e stili hanno "?v=" e possono restare in cache; i caratteri della mappa cambiano di rado.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(pbf|png|svg|webmanifest)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
